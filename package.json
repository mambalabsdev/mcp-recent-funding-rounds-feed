    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-recent-funding-rounds-feed"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-recent-funding-rounds-feed",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
